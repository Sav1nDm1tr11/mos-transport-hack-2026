# Copy to .env; set a private token (at least 16 characters).
TRANSPORT_API_TOKEN=replace-with-a-random-private-token
TRANSPORT_DB_PATH=.runtime/transport.sqlite
TRANSPORT_NDTP_HOST=127.0.0.1
TRANSPORT_NDTP_PORT=9201
TRANSPORT_RUN_ID=live
TRANSPORT_SCHEDULE_VERSION=default
TRANSPORT_PREDICTION_INTERVAL=30
# External ML service. Docker Compose uses http://ml-service:8090 by default.
TRANSPORT_ML_URL=http://127.0.0.1:8090
