# Copy to .env; set a private token (at least 16 characters).
TRANSPORT_API_TOKEN=replace-with-a-random-private-token
TRANSPORT_DB_PATH=.runtime/transport.sqlite
TRANSPORT_NDTP_HOST=127.0.0.1
TRANSPORT_NDTP_PORT=9201
TRANSPORT_RUN_ID=live
TRANSPORT_SCHEDULE_VERSION=default
TRANSPORT_PREDICTION_INTERVAL=30
# wall -- real time; replay -- virtual clock advanced by replay telemetry / explicit historical cycles.
TRANSPORT_CLOCK_MODE=wall
# External ML service. Docker Compose uses http://ml-service:8090 by default.
TRANSPORT_ML_URL=http://127.0.0.1:8090

# ML model routing. Cold RF is always required; full CatBoost is optional.
COLD_STRICT_MODEL_PATH=artifacts/models/cold_start_rf/checkpoints/cold_strict.pkl
COLD_PLUS_DEV_MODEL_PATH=artifacts/models/cold_start_rf/checkpoints/cold_plus_dev.pkl
FULL_CATBOOST_MODEL_PATH=artifacts/models/catboost/checkpoints/catboost_final.cbm
FULL_CATBOOST_METADATA_PATH=artifacts/models/catboost/checkpoints/catboost_final_metadata.json
FULL_HISTORY_MINUTES=30
FULL_MIN_SPAN_MINUTES=15
FULL_MIN_OBSERVATIONS=6
