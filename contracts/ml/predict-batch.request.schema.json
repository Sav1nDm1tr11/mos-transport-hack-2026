        "event_time": {
          "format": "date-time",
          "title": "Event Time",
          "type": "string"
        },
        "receive_time": {
          "format": "date-time",
          "title": "Receive Time",
          "type": "string"
        },
        "ingested_at": {
          "format": "date-time",
