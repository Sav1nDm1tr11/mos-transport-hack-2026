        "speed_kmh": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Speed Kmh"
        },
        "heading_deg": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Heading Deg"
        },
        "location_valid": {
          "title": "Location Valid",
          "type": "boolean"
        },
        "quality_flags": {
          "items": {
            "type": "string"
          },
          "title": "Quality Flags",
          "type": "array"
        },
        "source_identity": {
          "additionalProperties": true,
          "title": "Source Identity",
          "type": "object"
        }
