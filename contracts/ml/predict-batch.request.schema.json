    },
    "config_version": {
      "default": "1",
      "title": "Config Version",
      "type": "string"
    },
    "targets": {
      "items": {
        "$ref": "#/$defs/PredictionTarget"
      },
      "title": "Targets",
      "type": "array"
    },
    "telemetry": {
      "items": {
        "$ref": "#/$defs/TelemetryEvent"
      },
      "title": "Telemetry",
      "type": "array"
    },
    "schedule_context": {
      "items": {
        "$ref": "#/$defs/ScheduleVisit"
      },
      "title": "Schedule Context",
      "type": "array"
    }
  },
  "required": [
    "request_id",
    "run_id",
    "as_of",
    "schedule_version",
    "targets"
  ],
  "title": "PredictionBatch",
  "type": "object"
}
