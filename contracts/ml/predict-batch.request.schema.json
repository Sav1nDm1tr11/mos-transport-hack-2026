      "required": [
        "run_id",
        "event_id",
        "source",
        "tr_id",
        "unit_id",
        "event_time",
        "receive_time",
        "ingested_at",
        "location_valid"
      ],
      "title": "TelemetryEvent",
      "type": "object"
