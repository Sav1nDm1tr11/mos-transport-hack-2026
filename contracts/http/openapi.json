  "components": {
    "schemas": {
      "Binding": {
        "properties": {
          "tr_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "title": "Tr Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "tr_id"
        ],
        "title": "Binding"
      },
      "Cycle": {
        "properties": {
          "as_of": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "As Of"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "Cycle"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ReplayClock": {
        "properties": {
          "as_of": {
            "type": "string",
            "format": "date-time",
            "title": "As Of"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "as_of"
        ],
        "title": "ReplayClock"
      },
      "ScheduleVisit": {
        "properties": {
          "schedule_version": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Schedule Version"
          },
          "stop_visit_id": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Stop Visit Id"
          },
          "tr_id": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
